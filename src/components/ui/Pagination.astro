---
import type { Page } from "astro";
import LinkButton from "./LinkButton.astro";

interface Props {
    page: Page;
    class?: string | string[];
}
const { page, class: className } = Astro.props;

const isFirstPage = page.start === 0;
const isLastPage = page.end + 1 === page.total;
---

<nav
    aria-label="Pagination"
    class:list={["pagination", "flex items-center justify-between", className]}
>
    <p>
        Showing
        <span>{page.start + 1}</span>
        to
        <span>{page.end + 1}</span>
        of
        <span>{page.total}</span>
        results.
    </p>
    <div class:list={["pagination__controls", "inline-flex gap-4"]}>
        <LinkButton href={page.url.prev} disabled={!page.url.prev}>
            {isFirstPage ? <span aria-label="First page">&LeftArrowBar;</span> : <span aria-label="Previous page">&LeftArrow;</span>}
            Previous
        </LinkButton>
        <LinkButton href={page.url.next} disabled={!page.url.next}>
            Next
            {isLastPage ? <span aria-label="Last page">&RightArrowBar;</span> : <span aria-label="Next page">&RightArrow;</span>}
        </LinkButton>
    </div>
</nav>
