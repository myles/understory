---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"a">, "class" | "href"> {
  href?: string;
  disabled?: boolean;
  class?: string | string[];
}
const {
  href,
  disabled,
  class: className,
  title,
  target,
} = Astro.props as Props;
---

{
  href && !disabled ? (
    <a
      href={href}
      title={title}
      target={target}
      class:list={["link-button", "link-button--linked", className]}
    >
      <slot />
    </a>
  ) : (
    <span
      class:list={["link-button", "link-button--disabled", className]}
      aria-disabled="true"
    >
      <slot />
    </span>
  )
}
