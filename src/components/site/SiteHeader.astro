---
export interface Props {
    title: string;
    description?: string;
    class?: string | string[];
}
const { title, description, class: className } = Astro.props;
---

<header class:list={["site-header", className]}>
    <div class:list={["site-header__container"]}>
        <p class:list={["site-header__title"]}>
            <a href="/">{title}</a>
        </p>
        {description && <p class:list={["site-header__description"]}>{description}</p>}
    </div>
</header>
